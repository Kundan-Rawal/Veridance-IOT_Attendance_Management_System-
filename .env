# /home/pi/attendance_system/.env
# Fill these in AFTER you deploy the backend to Render.
# Never commit this file to GitHub.

# Your Render backend URL  (e.g. https://attendance-api.onrender.com)
CLOUD_API_BASE_URL=https://veridance-iot-attendance-management.onrender.com

# A long random string — same value must be set in Render's environment variables
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
CLOUD_API_KEY=VERIDANCEAPI
